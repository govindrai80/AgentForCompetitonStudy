{
  "name": "outreach-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Research-and-draft agent for B2B outreach: researches a prospect, matches your case studies to them, and writes a grounded email draft.",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "outreach": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "outreach": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
