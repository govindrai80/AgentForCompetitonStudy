# Anthropic API key — https://console.anthropic.com/settings/keys
# The SDK also accepts an `ant auth login` profile, in which case leave this unset.
ANTHROPIC_API_KEY=

# Optional: override the model for every stage (default: claude-opus-5)
# OUTREACH_MODEL=claude-opus-5

# --- Gmail draft creation (only needed when you pass --gmail) ---
# Desktop-app OAuth client from Google Cloud Console. See README "Gmail setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the refresh token gets cached after the one-time browser consent.
GMAIL_TOKEN_PATH=.gmail-token.json
